# ── Database (TiDB Cloud Starter / any MySQL 8) ──────────────────────
# TiDB: copy the Prisma connection string from the cluster "Connect" dialog.
# It must end with ?sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/swug?sslaccept=strict"

# ── Auth ────────────────────────────────────────────────────────────
# Long random string used to sign admin sessions.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# ── Media uploads (Vercel Blob) ─────────────────────────────────────
# Added automatically when you connect a Blob store to the Vercel project.
# For local dev without it, uploads are saved to public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# ── First super admin (used only by `npm run db:seed`) ──────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="SWUG Admin"
